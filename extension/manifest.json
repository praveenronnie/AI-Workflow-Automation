{
  "manifest_version": 3,
  "name": "FormIQ — AI Report Assistant",
  "version": "1.1.0",
  "description": "Intelligent filling for inspection reports: capture any web form, match your documents, review with confidence scores, fill with one click.",
  "permissions": ["activeTab", "storage", "scripting", "sidePanel"],
  "host_permissions": [
    "https://app.openquire.com/*",
    "http://localhost:8000/*"
  ],
  "side_panel": {
    "default_path": "ui/dist/index.html"
  },
  "action": {
    "default_title": "FormIQ — AI Report Assistant",
    "default_icon": {
      "16": "assets/icon128.svg",
      "48": "assets/icon128.svg",
      "128": "assets/icon128.svg"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "adapters/*",
        "domains/manifests/*"
      ],
      "matches": ["https://app.openquire.com/*"]
    }
  ],
  "icons": {
    "16": "assets/icon128.svg",
    "48": "assets/icon128.svg",
    "128": "assets/icon128.svg"
  }
}
