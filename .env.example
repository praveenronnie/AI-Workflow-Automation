# =====================================================================
# FormIQ — environment template (safe to commit: placeholders only).
#
#   dev  : copy to `.env` and fill in; URLs may point at localhost.
#   prod : `.env` lives ONLY on the server (chmod 600). All service URLs
#          MUST use docker-compose service names — a *localhost* base URL
#          inside a container is a bug, and the API refuses to start with
#          ENV=production if it finds one.
#
# Keys below are exactly those read by:
#   backend/core/config.py (Settings) · backend/ai/config.py (RagConfig)
#   backend/worker/modal_embeddings.py (HF_TOKEN)
# =====================================================================

# --- Runtime mode ("production" enables fail-fast config guards) ---
ENV=development

# --- PostgreSQL (backend/database/base.py builds the URL from these) ---
DB_HOST=localhost
DB_PORT=5434
DB_NAME=form_automation
DB_USERNAME=postgres
DB_PASSWORD=password

# --- Redis / Celery ---
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Auth ---
# Generate per environment: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it invalidates all tokens (users just log in again).
JWT_SECRET_KEY=

# Extension background fetches bypass CORS (host_permissions), but keep real
# origins for defense-in-depth. Prod: ["chrome-extension://<EXTENSION_ID>"].
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- LLM routing ---
# The LLM gateway (omniroute) runs as a compose service. Inside a container the
# ONLY valid value is the service name:
#   dev  : http://localhost:20128/v1   (or http://omniroute:20128/v1 in compose)
#   prod : http://omniroute:20128/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=http://omniroute:20128/v1
OPENAI_BASE_MODEL=kr/claude-haiku-4.5
NVIDIA_API_KEY=

# omniroute itself: first-boot admin password (change it; compose-only key).
OMNIROUTE_INITIAL_PASSWORD=

# --- Inference (Docling/embeddings via Modal) ---
USE_INFERENCE=True
INFERENCE_PROVIDER=modal
HF_TOKEN=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Vector DB (Qdrant) ---
VECTOR_DB_URL=http://qdrant:6333
VECTOR_DB_INDEX_NAME=universal_evidence

# --- Local file storage (uploads shared by api + worker; a named volume in prod) ---
# Defaults to <repo_root>/storage when unset.
# STORAGE_DIR=/app/storage

# --- Cloudflare R2 (S3-compatible; used for backups / future direct uploads) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- Reverse proxy (docker-compose.prod.yml + Caddyfile) ---
# Public hostname; Cloudflare DNS points here and Caddy issues the TLS cert.
API_DOMAIN=api.example.com
